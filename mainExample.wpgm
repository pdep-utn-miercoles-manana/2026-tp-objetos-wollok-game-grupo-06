import wollok.game.*
import example.pepita 

program juego {
	game.title("MessientoTriste")	
	game.height(13)		// Alto del tablero (cant de celdas)
	game.width(20)		// Ancho del tablero (cant de celdas) 
	game.cellSize(50)	// Tamaño celda en px (los jugadores deben ser del mismo tamaño)
	game.boardGround("cancha.png")	// Fondo del tablero

	game.addVisualCharacter(pepita) 

	game.start()
}
